# Copy this file to .env.local and fill in the values. Never commit .env.local.

# "sandbox" while testing, "production" when you go live
POLAR_ENV=sandbox

# Polar dashboard → Settings → Developers → New token
# (create it in sandbox.polar.sh for testing, polar.sh for live)
POLAR_ACCESS_TOKEN=

# Polar dashboard → Settings → Webhooks → add endpoint https://YOUR-DOMAIN/api/webhook/polar
POLAR_WEBHOOK_SECRET=

# Polar dashboard → Settings → General (Organization ID) — used for license-key validation
POLAR_ORGANIZATION_ID=

# Public URL of the site (no trailing slash)
SITE_URL=http://localhost:3000

# Optional: get a Telegram message on every sale
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
